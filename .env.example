# Optional. Leave unset to run the app fully free/local with extractive
# (non-LLM) grounded answers - this is the default and fully functional mode.
#
# If set, a free Groq API key (https://console.groq.com/keys) enables an
# optional layer that rephrases the grounded knowledge-base answer into a
# more natural sentence. It never adds facts beyond the retrieved answer.
GROQ_API_KEY=
